<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Master.master.cs" Inherits="ecommerce_web.Master" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>E-commerce Grupo F</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <script>
        (function () {
            try {
                if (localStorage.getItem("theme") === "dark") {
                    document.documentElement.classList.add("pre-dark-mode");
                }
            } catch (e) {}
        })();
    </script>

    <style>
        html.pre-dark-mode body {
            background-color: #121417;
            color: #e9ecef;
        }

        body.dark-mode {
            background-color: #121417;
            color: #e9ecef;
        }

        body.dark-mode .card,
        body.dark-mode .dark-mode-card {
            background-color: #1b1f24;
            color: #e9ecef;
            border-color: #2c323a !important;
        }

        body.dark-mode .dropdown-menu {
            background-color: #1b1f24;
            color: #e9ecef;
            border-color: #2c323a;
        }

        body.dark-mode .dropdown-item {
            color: #e9ecef;
        }

        body.dark-mode .dropdown-item:hover,
        body.dark-mode .dropdown-item:focus {
            background-color: #2a3038;
            color: #ffffff;
        }

        body.dark-mode .form-control,
        body.dark-mode .form-select {
            background-color: #16191d;
            color: #e9ecef;
            border-color: #343a40;
        }

        body.dark-mode .form-control:focus,
        body.dark-mode .form-select:focus {
            background-color: #16191d;
            color: #ffffff;
            border-color: #6ea8fe;
        }

        body.dark-mode .text-muted {
            color: #adb5bd !important;
        }

        body.dark-mode hr {
            border-color: #2c323a;
            opacity: 1;
        }
    </style>
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager ID="ScriptManager1" runat="server" />
        <nav class="navbar navbar-expand-lg bg-dark navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="Default.aspx">E-commerce Grupo F</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <!-- Menú de la izquierda -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link active" aria-current="page" href="Default.aspx">Inicio</a>
                        </li>

                        <!-- Botón Quiero Vender -->
                        <li class="nav-item ms-lg-2">
                            <a class="nav-link btn btn-success text-white px-3" href="Publicar.aspx">🏷️ QUIERO VENDER</a>
                        </li>

                        <!-- Botón de Admin controlado por código -->
                        <li class="nav-item">
                            <asp:HyperLink ID="lnkAdmin" runat="server" CssClass="nav-link btn btn-outline-warning text-white ms-2" NavigateUrl="~/Admin.aspx" Visible="false">Panel Admin ⚙️</asp:HyperLink>
                        </li>
                    </ul>

                    <!-- ZONA DE USUARIO (Alineada a la derecha) -->
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <!-- SELECTOR DE MONEDA (USD / ARS) -->
                        <div class="btn-group me-2" role="group" aria-label="Moneda">
                            <asp:LinkButton ID="btnMonedaUsd" runat="server" CssClass="btn btn-sm btn-outline-info active" CausesValidation="false" OnClick="BtnMonedaUsd_Click">USD</asp:LinkButton>
                            <asp:LinkButton ID="btnMonedaArs" runat="server" CssClass="btn btn-sm btn-outline-info" CausesValidation="false" OnClick="BtnMonedaArs_Click">ARS</asp:LinkButton>
                        </div>

                        <!-- SELECTOR DE TEMA (Claro / Oscuro) -->
                        <button type="button" id="btnTema" class="btn btn-sm btn-outline-light me-2" aria-pressed="false" title="Cambiar tema">
                            <span id="iconoTema" aria-hidden="true">🌙</span>
                            <span id="textoTema">Oscuro</span>
                        </button>

                        <!-- Si NO está logueado -->
                        <asp:PlaceHolder ID="phNoLogueado" runat="server">
                            <a href="Login.aspx" class="btn btn-outline-light me-2">Login</a>
                            <a href="Registro.aspx" class="btn btn-primary">Registrarse</a>
                        </asp:PlaceHolder>

                        <!-- Si SÍ está logueado -->
                        <asp:PlaceHolder ID="phLogueado" runat="server" Visible="false">
                            <span class="navbar-text text-light me-3" id="lblUser" runat="server">Hola, Usuario</span>
                            <div class="dropdown me-2">
                                <button class="btn btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Mi cuenta</button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" href="MiPerfil.aspx">Mi perfil</a></li>
                                    <li><a class="dropdown-item" href="MisPedidos.aspx">Mis pedidos</a></li>
                                    <li><a class="dropdown-item" href="MisVentas.aspx">Mis ventas</a></li>
                                </ul>
                            </div>
                            <asp:Button ID="btnSalir" runat="server" Text="Salir" CssClass="btn btn-outline-danger" CausesValidation="false" UseSubmitBehavior="false" OnClick="BtnSalir_Click" />
                        </asp:PlaceHolder>
                    </div>
                </div>
            </div>
        </nav>

        <div class="container">
            <hr />
            <div>
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        (function () {
            var KEY = "theme";
            var CLASS_DARK = "dark-mode";

            function leerTema() {
                try {
                    var guardado = localStorage.getItem(KEY);
                    if (guardado === "dark" || guardado === "light") return guardado;
                } catch (e) {}
                return document.documentElement.classList.contains("pre-dark-mode") ? "dark" : "light";
            }

            function actualizarBoton(esOscuro) {
                var btn = document.getElementById("btnTema");
                var icono = document.getElementById("iconoTema");
                var texto = document.getElementById("textoTema");

                if (btn) btn.setAttribute("aria-pressed", esOscuro ? "true" : "false");
                if (icono) icono.textContent = esOscuro ? "☀️" : "🌙";
                if (texto) texto.textContent = esOscuro ? "Claro" : "Oscuro";
            }

            function aplicarTema(tema) {
                var esOscuro = tema === "dark";
                document.body.classList.toggle(CLASS_DARK, esOscuro);
                document.documentElement.classList.toggle("pre-dark-mode", esOscuro);

                try {
                    localStorage.setItem(KEY, esOscuro ? "dark" : "light");
                } catch (e) {}

                actualizarBoton(esOscuro);
            }

            document.addEventListener("DOMContentLoaded", function () {
                aplicarTema(leerTema());

                var btn = document.getElementById("btnTema");
                if (btn) {
                    btn.addEventListener("click", function () {
                        var proximo = document.body.classList.contains(CLASS_DARK) ? "light" : "dark";
                        aplicarTema(proximo);
                    });
                }
            });
        })();
    </script>
</body>
</html>